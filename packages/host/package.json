{
  "name": "@dsh-layerfs/host",
  "version": "0.1.0",
  "description": "Host half of LayerFS × DSH: project bindings, the bash environment, trace collection into session records, and the /layerfs route",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": ["src", "vendor"],
  "imports": {
    "#layerfs/agent": "./vendor/layerfs/api/agent/src/index.js",
    "#layerfs/agent/internal": "./vendor/layerfs/api/agent/src/internal.js",
    "#layerfs/backend": "./vendor/layerfs/api/backend/src/index.js",
    "#layerfs/runtime": "./vendor/layerfs/api/runtime/src/index.js"
  },
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-alpha.4 <0.3.0"
  },
  "dependencies": {
    "@dsh-layerfs/model": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/schemastery": "*"
  }
}
